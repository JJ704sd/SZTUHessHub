{
  "name": "hseehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run content:check && npm run links:check && npm run evidence:check",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint-source.mjs",
    "content": "npm run content:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/content-validation.test.ts --reporter=dot",
    "validate:release-b-content": "node scripts/validate-content.mjs",
    "content:release-b-test": "node scripts/test-release-b-content.mjs",
    "pathways:check": "node scripts/validate-pathways.mjs",
    "content:check": "npm run validate:content && npm run phase11:content && npm run resources:check && npm run validate:release-b-content && npm run pathways:check && npm run content:release-b-test",
    "phase11:content": "node scripts/validate-phase-1-1-content.mjs",
    "links:check": "vitest run tests/link-validation.test.ts --reporter=dot && node scripts/check-links.mjs",
    "resources:check": "node scripts/check-resource-health.mjs",
    "resources:probe": "node scripts/check-resource-health.mjs --probe",
    "resources:snapshot": "node scripts/resources-snapshot.mjs",
    "evidence:check": "node scripts/check-evidence.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "a11y:smoke": "node scripts/a11y-smoke.mjs",
    "e2e:playwright": "playwright test",
    "test:e2e": "playwright test tests/e2e/home.spec.ts tests/e2e/release-a-baseline.spec.ts tests/e2e/release-c.spec.ts --project=desktop-light --project=mobile-light --project=narrow-light",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --project=desktop-light",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=desktop-light",
    "test:release-b-browser": "node scripts/run-release-b-browser-checks.mjs",
    "test:release-c-browser": "node scripts/run-release-b-browser-checks.mjs",
    "lighthouse": "node scripts/lighthouse-mobile.mjs",
    "perf:ci": "node scripts/perf-ci.mjs",
    "release:check": "node scripts/check-release-config.mjs",
    "structure:check": "node scripts/check-phase-1-1-structure.mjs",
    "events:check": "node scripts/check-analytics-contract.mjs",
    "env:check": "node scripts/check-environment.mjs",
    "metadata:check": "node scripts/check-metadata.mjs",
    "runtime:check": "node scripts/check-runtime-acceptance.mjs",
    "performance:check": "node scripts/check-performance.mjs",
    "rollback:check": "node scripts/check-rollback-rehearsal.mjs",
    "check": "npm run lint && npm run content:check && npm run links:check && npm run evidence:check && npm run structure:check && npm run events:check && npm run typecheck && npm run test && npm run build && npm run performance:check",
    "release-c:check": "node scripts/check-release-c.mjs",
    "check:release-b": "npm run check && npm run test:release-b-browser",
    "check:release-c": "npm run env:check && npm run check && npm run release-c:check && npm run test:release-c-browser"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "tsx": "^4.23.10",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  }
}
