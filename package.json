{
  "name": "hseehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run content:check && npm run links:check",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint-source.mjs",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "pathways:check": "node scripts/validate-pathways.mjs",
    "content:check": "npm run validate:content && npm run pathways:check",
    "content:release-b-test": "node scripts/test-release-b-content.mjs",
    "links:check": "node scripts/check-links.mjs",
    "test:e2e": "playwright test tests/e2e/home.spec.ts tests/e2e/release-a-baseline.spec.ts --project=desktop-light --project=mobile-light --project=narrow-light",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --project=desktop-light",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:release-b-browser": "node scripts/run-release-b-browser-checks.mjs",
    "lighthouse": "node scripts/lighthouse-mobile.mjs",
    "check": "npm run lint && npm run content:check && npm run links:check && npm run typecheck && npm run build",
    "check:release-b": "npm run check && npm run content:release-b-test && npm run test:release-b-browser"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "typescript": "5.7.3"
  }
}
